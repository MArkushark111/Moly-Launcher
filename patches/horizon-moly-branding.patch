+fn moly_archive(path: &std::path::Path) -> bool {
+    path.extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("rjar"))
+}
+
+fn installed_paths(game: &std::path::Path) -> Vec<PathBuf> {
+    let mut paths = horizon_mods::find(&game.join(mod_list::DIR));
+    for folder in [game.join("mods"), game.join(mod_list::DIR)] {
+        if let Ok(entries) = std::fs::read_dir(folder) {
+            paths.extend(entries.flatten().map(|e| e.path()).filter(|p| p.is_file() && moly_archive(p)));
+        }
+    }
+    paths.sort();
+    paths.dedup();
+    paths
+}
